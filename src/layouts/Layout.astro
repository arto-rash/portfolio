---
import "../styles/global.css";
import profile from "../data/profile.json";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noLenis?: boolean;
  noindex?: boolean;
}

const {
  title = `${profile.name} – ${profile.role}`,
  description = profile.tagline,
  ogImage = "/og-default.png",
  noLenis = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f2138" media="(prefers-color-scheme: dark)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only fixed left-3 top-3 z-50 bg-bg px-3 py-2 border border-ink font-mono text-xs"
      >skip to content</a
    >

    <slot />

    {!noLenis && (
      <script>
        import Lenis from "lenis";

        const lenis = new Lenis({
          duration: 1.05,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 1.2,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Anchor links use Lenis scrollTo
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
          a.addEventListener("click", (e) => {
            const href = a.getAttribute("href");
            if (!href || href === "#") return;
            const target = document.querySelector(href);
            if (!target) return;
            e.preventDefault();
            lenis.scrollTo(target as HTMLElement, { offset: -24, duration: 1.2 });
          });
        });

        (window as any).__lenis = lenis;
      </script>
    )}

    <script>
      // Scroll-reveal via IntersectionObserver
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
      );
      const observe = () => {
        document.querySelectorAll("[data-reveal]:not(.is-in)").forEach((el) => io.observe(el));
      };
      observe();
      // Re-scan after view transitions (Astro)
      document.addEventListener("astro:page-load", observe);
    </script>

    <script is:inline>
      const s = "color:#d9481c;font:600 13px ui-monospace,monospace";
      console.log("%centry 001: hey. nice to meet you.", s);
    </script>
  </body>
</html>
