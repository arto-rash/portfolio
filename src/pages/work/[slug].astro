---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Sketch from "../../components/Sketch.astro";
import projects from "../../data/projects.json";
import { resolveProjectImages } from "../../lib/og";
import Slideshow from "../../components/Slideshow.astro";

export async function getStaticPaths() {
  const resolved = await resolveProjectImages(projects);
  return resolved.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: p,
      prev: resolved[(i - 1 + resolved.length) % resolved.length],
      next: resolved[(i + 1) % resolved.length],
    },
  }));
}

const { project, prev, next } = Astro.props;

// gallery: manual screenshots win, else the single auto-resolved preview
const gallery: string[] =
  project.screenshots && project.screenshots.length
    ? project.screenshots
    : project.resolvedImage
      ? [project.resolvedImage]
      : [];

const links = project.links?.length
  ? project.links
  : project.url
    ? [{ label: "Live", url: project.url }]
    : [];

const hasSketch = ["escaflow", "odlar", "fermachi", "jabish"].includes(project.slug);
---

<Layout title={`${project.title} – Artoghrul Rashid`} description={project.description}>
  <Nav showHome />
  <main id="main" class="pt-28 md:pt-32 pb-24 px-5 md:px-8">
    <article class="mx-auto max-w-5xl">
      <a href="/#work" class="link-arrow font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint hover:text-accent transition-colors">
        <span class="arrow">←</span><span>back to the logbook</span>
      </a>

      <header class="mt-10 mb-10 grid grid-cols-12 gap-x-8 gap-y-6 items-end">
        <div class="col-span-12 md:col-span-8">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint mb-4">
            <span class={project.status === "live" ? "text-accent" : undefined}>● {project.status}</span>
            <span>·</span>
            <span>{project.role}</span>
            {project.period && <><span>·</span><span class="tabular">{project.period}</span></>}
          </div>
          <h1 class="font-display text-[clamp(44px,8vw,88px)] leading-[1]" data-reveal>{project.title}</h1>
          <p class="mt-5 text-[17px] md:text-[19px] leading-[1.5] text-ink-soft max-w-[52ch]" data-reveal style="--reveal-delay:80ms">
            {project.tagline}
          </p>
        </div>
        <div class="col-span-12 md:col-span-4 flex md:justify-end">
          {project.stamp && <span class="stamp stamp-inline text-[12px]">{project.stamp}</span>}
        </div>
      </header>

      {links.length > 0 && (
        <div class="mb-12 flex flex-wrap items-center gap-3" data-reveal>
          {links.map((l, i) => (
            <a href={l.url} target="_blank" rel="noreferrer" class:list={["btn", i === 0 && "btn-primary"]}>
              {l.label} ↗
            </a>
          ))}
        </div>
      )}

      {hasSketch && (
        <figure class="entry p-5 md:p-8 mb-12" data-reveal>
          <figcaption class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint mb-4">fig. 1 · how it works</figcaption>
          <div class="max-w-2xl mx-auto"><Sketch slug={project.slug} draw /></div>
        </figure>
      )}

      {gallery.length > 0 && (
        <div class="entry p-2 mb-12" data-reveal>
          <Slideshow images={gallery} alt={project.title} ratio="aspect-[16/10]" />
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-12 gap-x-10 gap-y-8">
        <div class="md:col-span-8 min-w-0">
          <p class="text-[16.5px] leading-[1.8] text-ink-soft">{project.longDescription ?? project.description}</p>
        </div>
        <aside class="md:col-span-4 md:border-l-2 md:border-dashed md:border-rule-hi md:pl-6 space-y-6">
          <div>
            <div class="scrawl text-[18px] mb-2">built with</div>
            <ul class="flex flex-wrap gap-2">
              {project.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </div>
          <div>
            <div class="scrawl text-[18px] mb-1">my part</div>
            <div class="font-mono text-[12.5px] text-ink-soft">{project.role}</div>
          </div>
        </aside>
      </div>

      <hr class="my-14 border-t-2 border-ink" />

      <nav class="flex items-center justify-between gap-6">
        <a href={`/work/${prev.slug}`} class="link-arrow text-ink-faint hover:text-accent transition-colors min-w-0">
          <span class="arrow font-mono">←</span><span class="font-display text-[20px] truncate">{prev.title}</span>
        </a>
        <a href={`/work/${next.slug}`} class="link-arrow text-ink-faint hover:text-accent transition-colors text-right min-w-0">
          <span class="font-display text-[20px] truncate">{next.title}</span><span class="arrow font-mono">→</span>
        </a>
      </nav>
    </article>
  </main>
  <Footer />
</Layout>
