---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import projects from "../../data/projects.json";
import { resolveProjectImages } from "../../lib/og";
import Slideshow from "../../components/Slideshow.astro";

export async function getStaticPaths() {
  const resolved = await resolveProjectImages(projects);
  return resolved.map((p, i) => ({
    params: { slug: p.slug },
    props: {
      project: p,
      prev: resolved[(i - 1 + resolved.length) % resolved.length],
      next: resolved[(i + 1) % resolved.length],
    },
  }));
}

const { project, prev, next } = Astro.props;

// gallery: manual screenshots win, else the single auto-resolved preview
const gallery: string[] =
  project.screenshots && project.screenshots.length
    ? project.screenshots
    : project.resolvedImage
      ? [project.resolvedImage]
      : [];

const links = project.links?.length
  ? project.links
  : project.url
    ? [{ label: "Live", url: project.url }]
    : [];
---

<Layout title={`${project.title} – Artoghrul Rashid`} description={project.description}>
  <Nav showHome />
  <main id="main" class="pt-32 pb-24 px-5 md:px-8">
    <article class="mx-auto max-w-4xl">
      <a href="/#work" class="link-arrow font-mono text-[11px] uppercase tracking-[0.14em] text-ink-faint hover:text-ink transition-colors">
        <span class="arrow">←</span><span>all work</span>
      </a>

      <header class="mt-10 mb-10">
        <div class="flex flex-wrap items-center gap-3 eyebrow mb-5">
          <span class={project.status === "live" ? "text-accent" : undefined}>{project.status}</span>
          <span class="text-ink-dim">·</span>
          <span>{project.role}</span>
        </div>
        <h1 class="font-display font-semibold tracking-[-0.03em] text-[clamp(40px,7vw,76px)] leading-[1.02]" data-reveal>
          {project.title}
        </h1>
        <p class="mt-5 text-[17px] md:text-[20px] leading-[1.5] text-ink-soft max-w-[60ch]" data-reveal style="--reveal-delay:80ms">
          {project.tagline}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:160ms">
          {links.map((l, i) => (
            <a href={l.url} target="_blank" rel="noreferrer" class:list={["btn", i === 0 && "btn-primary"]}>
              {l.label} ↗
            </a>
          ))}
        </div>
      </header>

      {/* Gallery – slideshow when there are multiple shots, single image otherwise */}
      {gallery.length > 0 && (
        <div class="mb-12" data-reveal>
          <Slideshow images={gallery} alt={project.title} ratio="aspect-[16/10]" />
        </div>
      )}

      {/* Body */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-x-10 gap-y-8">
        <div class="md:col-span-8">
          <p class="text-[16.5px] leading-[1.75] text-ink-soft">{project.longDescription ?? project.description}</p>
        </div>
        <aside class="md:col-span-4 space-y-6">
          <div>
            <div class="eyebrow mb-2.5">stack</div>
            <ul class="flex flex-wrap gap-2">
              {project.stack.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </div>
          <div>
            <div class="eyebrow mb-2.5">role</div>
            <div class="font-mono text-[12.5px] text-ink-soft">{project.role}</div>
          </div>
        </aside>
      </div>

      <hr class="my-14" />

      <nav class="flex items-center justify-between gap-6 font-mono text-[11px] uppercase tracking-[0.14em]">
        <a href={`/work/${prev.slug}`} class="link-arrow text-ink-faint hover:text-ink transition-colors">
          <span class="arrow">←</span><span>{prev.title}</span>
        </a>
        <a href={`/work/${next.slug}`} class="link-arrow text-ink-faint hover:text-ink transition-colors text-right">
          <span>{next.title}</span><span class="arrow">→</span>
        </a>
      </nav>
    </article>
  </main>
  <Footer />
</Layout>
