---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = posts.reduce<Record<number, typeof posts>>((acc, p) => {
  const y = p.data.date.getFullYear();
  (acc[y] ??= []).push(p);
  return acc;
}, {});

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

function fmt(d: Date) {
  return new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short" }).format(d);
}
---

<Layout title="Writing — Artoghrul Rashid" description="Essays and notes on engineering craft, from the database up.">
  <Nav showHome />
  <main id="main" class="pt-32 pb-24 px-5 md:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="eyebrow mb-4">writing</div>
      <h1 class="font-display text-[58px] md:text-[92px] leading-[0.95] tracking-tight" data-reveal>
        Notes from <span class="italic text-accent">the field</span>.
      </h1>
      <p class="mt-8 text-[17px] md:text-[19px] text-ink-soft max-w-[58ch]" data-reveal style="--reveal-delay:120ms">
        Interesting things to share.
      </p>

      <div class="mt-20 space-y-16">
        {years.length === 0 ? (
          <p class="text-ink-soft">Nothing here yet.</p>
        ) : years.map((y) => (
          <section data-reveal>
            <div class="flex items-baseline justify-between mb-6">
              <h2 class="font-display text-[28px] text-ink-faint">{y}</h2>
              <span class="eyebrow">{byYear[y].length} {byYear[y].length === 1 ? "post" : "posts"}</span>
            </div>
            <ul class="divide-y divide-rule border-y border-rule">
              {byYear[y].map((p) => (
                <li>
                  <a href={`/blog/${p.id}`} class="group grid grid-cols-12 gap-x-6 gap-y-2 py-6 items-baseline">
                    <div class="col-span-3 md:col-span-2 font-mono text-[12px] text-ink-faint tabular">
                      {fmt(p.data.date)}
                    </div>
                    <div class="col-span-9 md:col-span-7">
                      <h3 class="font-display text-[24px] md:text-[30px] leading-[1.12] group-hover:text-accent transition-colors">
                        {p.data.title}
                      </h3>
                      <p class="mt-1 text-[14.5px] text-ink-soft max-w-[60ch]">{p.data.excerpt}</p>
                    </div>
                    <div class="col-span-12 md:col-span-3 md:text-right font-mono text-[11px] uppercase tracking-[0.14em] text-ink-faint">
                      {p.data.tags.slice(0, 2).join(" · ")}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
