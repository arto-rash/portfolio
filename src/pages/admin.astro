---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";

const configured = !!site.sheetApi;

// Paste this into Extensions → Apps Script, set SECRET, then redeploy the SAME
// web app as a NEW VERSION (Manage deployments → edit → Version: New version).
const APPS_SCRIPT = `const SECRET = 'change-me'; // your admin password — used to write

function doGet() {
  return json(readAll());
}

function doPost(e) {
  var body = {};
  try { body = JSON.parse(e.postData.contents); } catch (err) {}
  if (body.token !== SECRET) return json({ error: 'unauthorized' });

  if (body.action === 'ping') return json({ ok: true });
  if (body.action === 'saveSettings') saveSettings(body.settings || {});
  else if (body.action === 'savePost') savePost(body.post || {});
  else if (body.action === 'deletePost') deletePost(body.slug);
  else if (body.action === 'saveExperience') saveExperience(body.experience || {});
  else if (body.action === 'deleteExperience') deleteExperience(body.row);
  else if (body.action === 'saveProject') saveProject(body.project || {});
  else if (body.action === 'deleteProject') deleteProject(body.slug);

  return json(readAll());
}

function readAll() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var out = { settings: {}, posts: [], experience: [], projects: [] };

  // settings: row 1 = headers, row 2 = values (one row of values)
  var s = ss.getSheetByName('settings');
  if (s && s.getLastRow() >= 2) {
    var sv = s.getDataRange().getValues();
    var shead = sv[0], srow = sv[1];
    shead.forEach(function (h, i) { if (h) out.settings[h] = srow[i]; });
  }

  // posts: row 1 = headers, one post per row after that
  var p = ss.getSheetByName('posts');
  if (p && p.getLastRow() >= 2) {
    var rows = p.getDataRange().getValues();
    var phead = rows.shift();
    rows.forEach(function (r) {
      var o = {};
      phead.forEach(function (h, i) { o[h] = r[i]; });
      if (o.slug) out.posts.push(o);
    });
  }

  // experience: row 1 = headers, one per row after (_row = the sheet row)
  var x = ss.getSheetByName('experience');
  if (x && x.getLastRow() >= 2) {
    var xv = x.getDataRange().getValues();
    var xhead = xv[0];
    for (var i = 1; i < xv.length; i++) {
      var eo = { _row: i + 1 };
      xhead.forEach(function (h, j) { if (h) eo[h] = xv[i][j]; });
      if (eo.role || eo.company) out.experience.push(eo);
    }
  }

  // projects: row 1 = headers, one per row after
  var pr = ss.getSheetByName('projects');
  if (pr && pr.getLastRow() >= 2) {
    var prv = pr.getDataRange().getValues();
    var prhead = prv.shift();
    prv.forEach(function (r) {
      var o = {};
      prhead.forEach(function (h, i) { o[h] = r[i]; });
      if (o.slug) out.projects.push(o);
    });
  }

  return out;
}

function saveSettings(obj) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('settings');
  if (!sh) return;
  var head = sh.getLastColumn() ? sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0] : [];
  Object.keys(obj).forEach(function (k) {
    var col = head.indexOf(k);
    if (col < 0) { head.push(k); col = head.length - 1; sh.getRange(1, col + 1).setValue(k); }
    sh.getRange(2, col + 1).setValue(obj[k]); // value always on row 2
  });
}

function savePost(post) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('posts');
  if (!sh) return;
  var head = ['slug', 'title', 'date', 'excerpt', 'tags', 'draft', 'body'];
  if (sh.getLastRow() === 0) sh.appendRow(head);
  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var slugCol = headers.indexOf('slug');
  var rowIndex = -1;
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][slugCol]) === String(post.slug)) { rowIndex = i + 1; break; }
  }
  var row = headers.map(function (h) { return post[h] != null ? post[h] : ''; });
  if (rowIndex > 0) sh.getRange(rowIndex, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
}

function deletePost(slug) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('posts');
  if (!sh) return;
  var data = sh.getDataRange().getValues();
  var slugCol = data[0].indexOf('slug');
  for (var i = data.length - 1; i >= 1; i--) {
    if (String(data[i][slugCol]) === String(slug)) sh.deleteRow(i + 1);
  }
}

function saveExperience(x) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('experience') || ss.insertSheet('experience');
  var head = ['role', 'company', 'location', 'start', 'end', 'current', 'description'];
  if (sh.getLastRow() === 0) sh.appendRow(head);
  var headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
  var row = headers.map(function (h) { return x[h] != null ? x[h] : ''; });
  if (x._row && x._row >= 2) sh.getRange(x._row, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
}

function deleteExperience(rowNum) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('experience');
  if (!sh || !rowNum || rowNum < 2) return;
  sh.deleteRow(rowNum);
}

function saveProject(proj) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('projects') || ss.insertSheet('projects');
  var head = ['slug', 'title', 'tagline', 'role', 'status', 'stack', 'url', 'image', 'description', 'longDescription', 'accent', 'featured'];
  if (sh.getLastRow() === 0) sh.appendRow(head);
  var data = sh.getDataRange().getValues();
  var headers = data[0];
  var slugCol = headers.indexOf('slug');
  var rowIndex = -1;
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][slugCol]) === String(proj.slug)) { rowIndex = i + 1; break; }
  }
  var row = headers.map(function (h) { return proj[h] != null ? proj[h] : ''; });
  if (rowIndex > 0) sh.getRange(rowIndex, 1, 1, row.length).setValues([row]);
  else sh.appendRow(row);
}

function deleteProject(slug) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('projects');
  if (!sh) return;
  var data = sh.getDataRange().getValues();
  var slugCol = data[0].indexOf('slug');
  for (var i = data.length - 1; i >= 1; i--) {
    if (String(data[i][slugCol]) === String(slug)) sh.deleteRow(i + 1);
  }
}

function json(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}`;
---

<Layout title="Admin – Artoghrul Rashid" description="Content dashboard" noindex noLenis>
  <Nav showHome />
  <main id="main" class="pt-32 pb-24 px-5 md:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="flex items-baseline justify-between border-b border-rule pb-4">
        <h1 class="eyebrow">admin · content</h1>
        <div class="flex items-center gap-5">
          <span id="status" class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint">checking…</span>
          <button id="lock-btn" class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint hover:text-ink transition-colors" hidden>lock</button>
        </div>
      </div>

      {!configured && (
        <p class="mt-6 text-[15px] leading-[1.7] text-ink-soft max-w-[60ch]">
          No sheet connected yet — the site is running on its built-in content. Do the
          setup below, put your Web-App URL in <code>src/data/site.json</code>, redeploy once,
          then this page becomes your editor.
        </p>
      )}

      {/* Password gate */}
      <section id="gate" class="mt-12" hidden>
        <div class="eyebrow border-b border-rule pb-3 mb-6">locked</div>
        <label class="lbl" for="pw">password</label>
        <div class="flex gap-3 max-w-sm">
          <input id="pw" type="password" class="f-input" autocomplete="current-password" placeholder="•••••••" />
          <button id="unlock-btn" class="btn btn-primary shrink-0">unlock</button>
        </div>
        <p id="gate-msg" class="mt-3 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint"></p>
        <p class="mt-4 text-[13px] text-ink-faint max-w-[52ch]">
          The password is the <code>SECRET</code> you set in the Apps Script. It's checked on the
          Google side — writes are rejected without it.
        </p>
      </section>

      {/* Editor */}
      <div id="editor" hidden>
        {/* Settings */}
        <section class="mt-12">
          <div class="eyebrow border-b border-rule pb-3">site settings</div>
          <div class="mt-5 flex items-center gap-3">
            <input id="sf-available" type="checkbox" />
            <label for="sf-available" class="text-[14px] text-ink-soft">show "available for…" on the homepage</label>
          </div>
          <label class="lbl" for="sf-availableFor">available for</label>
          <input id="sf-availableFor" type="text" class="f-input" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><label class="lbl" for="sf-songTitle">song title</label><input id="sf-songTitle" type="text" class="f-input" /></div>
            <div><label class="lbl" for="sf-songArtist">song artist</label><input id="sf-songArtist" type="text" class="f-input" /></div>
          </div>
          <label class="lbl" for="sf-songNote">song note</label>
          <input id="sf-songNote" type="text" class="f-input" />
          <label class="lbl" for="sf-songUrl">song url</label>
          <input id="sf-songUrl" type="url" class="f-input" placeholder="https://…" />
          <div class="mt-5 flex items-center gap-4">
            <button id="sf-save" class="btn btn-primary">save settings</button>
            <span id="sf-msg" class="saved-msg"></span>
          </div>
        </section>

        {/* Posts */}
        <section class="mt-14">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <div class="eyebrow">posts</div>
            <div class="flex items-center gap-5">
              {site.sheetUrl && (
                <a href={site.sheetUrl} target="_blank" rel="noreferrer" class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint hover:text-ink transition-colors">open sheet ↗</a>
              )}
              <button id="p-new" class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint hover:text-ink transition-colors">+ new post</button>
            </div>
          </div>
          <div id="posts-list" class="mt-2 text-[14px]">—</div>

          <div id="post-form" class="mt-6 border-t border-dashed border-rule pt-6" hidden>
            <label class="lbl" for="pf-title">title</label>
            <input id="pf-title" type="text" class="f-input" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label class="lbl" for="pf-slug">slug</label><input id="pf-slug" type="text" class="f-input" /></div>
              <div><label class="lbl" for="pf-date">date</label><input id="pf-date" type="date" class="f-input" /></div>
            </div>
            <label class="lbl" for="pf-excerpt">excerpt</label>
            <input id="pf-excerpt" type="text" class="f-input" />
            <label class="lbl" for="pf-tags">tags (comma separated)</label>
            <input id="pf-tags" type="text" class="f-input" placeholder="engineering, astro" />
            <div class="mt-4 flex items-center gap-3">
              <input id="pf-draft" type="checkbox" />
              <label for="pf-draft" class="text-[14px] text-ink-soft">draft (hidden from the site)</label>
            </div>
            <label class="lbl" for="pf-body">body (markdown)</label>
            <textarea id="pf-body" rows="14" class="f-input font-mono text-[13px]"></textarea>
            <div class="mt-5 flex items-center gap-4">
              <button id="pf-save" class="btn btn-primary">save post</button>
              <button id="pf-cancel" class="btn">cancel</button>
              <span id="pf-msg" class="saved-msg"></span>
            </div>
          </div>
        </section>

        {/* Workplaces */}
        <section class="mt-14">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <div class="eyebrow">workplaces</div>
            <button id="x-new" class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint hover:text-ink transition-colors">+ new workplace</button>
          </div>
          <div id="exp-list-admin" class="mt-2 text-[14px]">—</div>

          <div id="exp-form" class="mt-6 border-t border-dashed border-rule pt-6" hidden>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label class="lbl" for="xf-role">role</label><input id="xf-role" type="text" class="f-input" /></div>
              <div><label class="lbl" for="xf-company">company</label><input id="xf-company" type="text" class="f-input" /></div>
            </div>
            <label class="lbl" for="xf-location">location</label>
            <input id="xf-location" type="text" class="f-input" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label class="lbl" for="xf-start">start (yyyy-mm)</label><input id="xf-start" type="text" class="f-input" placeholder="2025-06" /></div>
              <div><label class="lbl" for="xf-end">end (yyyy-mm)</label><input id="xf-end" type="text" class="f-input" placeholder="blank if current" /></div>
            </div>
            <div class="mt-4 flex items-center gap-3">
              <input id="xf-current" type="checkbox" />
              <label for="xf-current" class="text-[14px] text-ink-soft">current job (shows "now")</label>
            </div>
            <label class="lbl" for="xf-description">description (optional)</label>
            <textarea id="xf-description" rows="3" class="f-input"></textarea>
            <div class="mt-5 flex items-center gap-4">
              <button id="xf-save" class="btn btn-primary">save workplace</button>
              <button id="xf-cancel" class="btn">cancel</button>
              <span id="xf-msg" class="saved-msg"></span>
            </div>
          </div>
        </section>

        {/* Projects */}
        <section class="mt-14">
          <div class="flex items-baseline justify-between border-b border-rule pb-3">
            <div class="eyebrow">projects</div>
            <button id="pr-new" class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint hover:text-ink transition-colors">+ new project</button>
          </div>
          <div id="proj-list" class="mt-2 text-[14px]">—</div>

          <div id="proj-form" class="mt-6 border-t border-dashed border-rule pt-6" hidden>
            <label class="lbl" for="rf-title">title</label>
            <input id="rf-title" type="text" class="f-input" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label class="lbl" for="rf-slug">slug</label><input id="rf-slug" type="text" class="f-input" /></div>
              <div><label class="lbl" for="rf-url">url</label><input id="rf-url" type="url" class="f-input" placeholder="https://…" /></div>
            </div>
            <label class="lbl" for="rf-tagline">tagline</label>
            <input id="rf-tagline" type="text" class="f-input" />
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div><label class="lbl" for="rf-role">role</label><input id="rf-role" type="text" class="f-input" placeholder="full-stack" /></div>
              <div><label class="lbl" for="rf-status">status</label><input id="rf-status" type="text" class="f-input" placeholder="live" /></div>
              <div><label class="lbl" for="rf-accent">accent (hex)</label><input id="rf-accent" type="text" class="f-input" placeholder="#2f9e44" /></div>
            </div>
            <label class="lbl" for="rf-stack">stack (comma separated)</label>
            <input id="rf-stack" type="text" class="f-input" placeholder="Laravel, Next.js, PostgreSQL" />
            <label class="lbl" for="rf-image">image url (optional — blank = gradient)</label>
            <input id="rf-image" type="url" class="f-input" placeholder="https://…" />
            <label class="lbl" for="rf-description">short description</label>
            <textarea id="rf-description" rows="2" class="f-input"></textarea>
            <label class="lbl" for="rf-longDescription">long description</label>
            <textarea id="rf-longDescription" rows="5" class="f-input"></textarea>
            <div class="mt-4 flex items-center gap-3">
              <input id="rf-featured" type="checkbox" />
              <label for="rf-featured" class="text-[14px] text-ink-soft">featured</label>
            </div>
            <div class="mt-5 flex items-center gap-4">
              <button id="rf-save" class="btn btn-primary">save project</button>
              <button id="rf-cancel" class="btn">cancel</button>
              <span id="rf-msg" class="saved-msg"></span>
            </div>
          </div>
        </section>
      </div>

      {/* Setup */}
      <section class="mt-16">
        <div class="eyebrow border-b border-rule pb-3">setup / update the script</div>
        <ol class="mt-5 space-y-3 text-[14.5px] leading-[1.65] text-ink-soft list-decimal pl-5">
          <li>Two tabs, both "row 1 = headers, rows below = data". <strong class="text-ink">settings</strong> — row 1 headers, spelled exactly: <code>available</code>, <code>availableFor</code>, <code>songTitle</code>, <code>songArtist</code>, <code>songNote</code>, <code>songUrl</code>; put the values on row 2 (no <code>(TRUE/FALSE)</code> text in the header — just <code>available</code>). <strong class="text-ink">posts</strong> — row 1 headers: <code>slug</code>, <code>title</code>, <code>date</code>, <code>excerpt</code>, <code>tags</code>, <code>draft</code>, <code>body</code>; one post per row. The <strong class="text-ink">experience</strong> and <strong class="text-ink">projects</strong> tabs are created for you automatically the first time you add one below.</li>
          <li>Extensions → Apps Script, paste the code below, set <code>SECRET</code> to your chosen password.</li>
          <li>Deploy → Manage deployments → edit (pencil) → Version: <strong class="text-ink">New version</strong> → Deploy. The <code>/exec</code> URL stays the same.</li>
          <li>Make sure <code>src/data/site.json</code> → <code>sheetApi</code> holds that URL (and <code>sheetUrl</code> the sheet's edit link), then redeploy the site once.</li>
        </ol>
        <div class="eyebrow mt-8 mb-2">Apps Script</div>
        <pre class="text-[12.5px] leading-[1.6] text-ink bg-bg-2 border border-rule p-4 overflow-x-auto"><code>{APPS_SCRIPT}</code></pre>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .lbl {
    display: block;
    margin: 16px 0 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-faint);
  }
  .f-input {
    width: 100%;
    border: 1px solid var(--color-rule);
    border-radius: 0;
    padding: 9px 11px;
    font-size: 14px;
    background: #fff;
    color: var(--color-ink);
    outline: none;
  }
  .f-input:focus { border-color: var(--color-ink); }
  textarea.f-input { resize: vertical; line-height: 1.6; }
  .saved-msg {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-faint);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .saved-msg.on { opacity: 1; }
  .saved-msg.err { color: var(--color-accent); }
</style>

<script>
  import site from "../data/site.json";
  import { fmtDate } from "../lib/sheet";

  const API = (site as { sheetApi?: string }).sheetApi || "";
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) =>
    String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  const isTrue = (v: unknown) => v === true || String(v ?? "").trim().toLowerCase() === "true";

  const statusEl = $("status");
  const gateEl = $("gate");
  const editorEl = $("editor");
  const lockBtn = $("lock-btn");

  let editingSlug: string | null = null;

  async function fetchState(): Promise<any | null> {
    if (!API) return null;
    try {
      const r = await fetch(API, { redirect: "follow" });
      return r.ok ? await r.json() : null;
    } catch {
      return null;
    }
  }

  async function apiPost(payload: Record<string, unknown>): Promise<any | null> {
    const token = sessionStorage.getItem("adminToken") || "";
    try {
      const r = await fetch(API, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({ ...payload, token }),
        redirect: "follow",
      });
      try {
        return await r.json();
      } catch {
        return { unread: true }; // write likely landed; response not readable
      }
    } catch {
      return null;
    }
  }

  function flash(id: string, msg: string, err = false) {
    const el = $(id);
    el.textContent = msg;
    el.classList.toggle("err", err);
    el.classList.add("on");
    setTimeout(() => el.classList.remove("on"), 2600);
  }

  function showGate() {
    gateEl.hidden = false;
    editorEl.hidden = true;
    lockBtn.hidden = true;
  }
  function showEditor() {
    gateEl.hidden = true;
    editorEl.hidden = false;
    lockBtn.hidden = false;
  }

  function renderSettings(s: Record<string, any>) {
    ($("sf-available") as HTMLInputElement).checked = isTrue(s.available);
    ($("sf-availableFor") as HTMLInputElement).value = s.availableFor ?? "";
    ($("sf-songTitle") as HTMLInputElement).value = s.songTitle ?? "";
    ($("sf-songArtist") as HTMLInputElement).value = s.songArtist ?? "";
    ($("sf-songNote") as HTMLInputElement).value = s.songNote ?? "";
    ($("sf-songUrl") as HTMLInputElement).value = s.songUrl ?? "";
  }

  function renderPosts(posts: any[]) {
    const box = $("posts-list");
    if (!posts.length) {
      box.innerHTML = '<div class="text-ink-faint py-3">no posts yet — add one.</div>';
      return;
    }
    box.innerHTML = posts
      .slice()
      .sort((a, b) => (String(a.date) < String(b.date) ? 1 : -1))
      .map(
        (p) =>
          '<div class="flex items-baseline gap-4 py-3 border-b border-rule">' +
          '<span class="font-mono text-[11px] text-ink-faint tabular w-24 shrink-0">' + esc(fmtDate(String(p.date))) + "</span>" +
          '<span class="flex-1 text-ink">' + esc(p.title) + "</span>" +
          (isTrue(p.draft) ? '<span class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-faint border border-rule px-1.5">draft</span>' : "") +
          '<button class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-faint hover:text-ink transition-colors" data-edit="' + esc(p.slug) + '">edit</button>' +
          '<button class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-faint hover:text-accent transition-colors" data-del="' + esc(p.slug) + '">delete</button>' +
          "</div>",
      )
      .join("");
  }

  let allPosts: any[] = [];
  let allExp: any[] = [];
  let allProjects: any[] = [];
  let editingRow: number | null = null;
  let editingProjSlug: string | null = null;

  function render(state: any) {
    renderSettings(state.settings || {});
    allPosts = state.posts || [];
    renderPosts(allPosts);
    allExp = state.experience || [];
    renderExp(allExp);
    allProjects = state.projects || [];
    renderProjects(allProjects);
  }

  async function loadAndRender() {
    const state = await fetchState();
    if (state) render(state);
  }

  // ---- settings save ----
  $("sf-save").addEventListener("click", async () => {
    const payload = {
      action: "saveSettings",
      settings: {
        available: ($("sf-available") as HTMLInputElement).checked,
        availableFor: ($("sf-availableFor") as HTMLInputElement).value.trim(),
        songTitle: ($("sf-songTitle") as HTMLInputElement).value.trim(),
        songArtist: ($("sf-songArtist") as HTMLInputElement).value.trim(),
        songNote: ($("sf-songNote") as HTMLInputElement).value.trim(),
        songUrl: ($("sf-songUrl") as HTMLInputElement).value.trim(),
      },
    };
    const res = await apiPost(payload);
    if (res?.error === "unauthorized") return handleUnauthorized("sf-msg");
    if (res?.settings) render(res);
    else await loadAndRender();
    flash("sf-msg", "saved");
  });

  // ---- post form ----
  function openForm(post: any | null) {
    editingSlug = post ? String(post.slug) : null;
    ($("pf-title") as HTMLInputElement).value = post ? post.title ?? "" : "";
    ($("pf-slug") as HTMLInputElement).value = post ? String(post.slug) : "";
    ($("pf-date") as HTMLInputElement).value = post ? String(post.date).slice(0, 10) : new Date().toISOString().slice(0, 10);
    ($("pf-excerpt") as HTMLInputElement).value = post ? post.excerpt ?? "" : "";
    ($("pf-tags") as HTMLInputElement).value = post ? String(post.tags ?? "") : "";
    ($("pf-draft") as HTMLInputElement).checked = post ? isTrue(post.draft) : false;
    ($("pf-body") as HTMLTextAreaElement).value = post ? post.body ?? "" : "";
    $("post-form").hidden = false;
    $("pf-title").scrollIntoView({ behavior: "smooth", block: "center" });
  }

  const slugify = (t: string) =>
    t.toLowerCase().replace(/['’]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

  $("pf-title").addEventListener("input", () => {
    if (editingSlug) return;
    ($("pf-slug") as HTMLInputElement).value = slugify(($("pf-title") as HTMLInputElement).value);
  });

  $("p-new").addEventListener("click", () => openForm(null));
  $("pf-cancel").addEventListener("click", () => ($("post-form").hidden = true));

  $("pf-save").addEventListener("click", async () => {
    const slug = ($("pf-slug") as HTMLInputElement).value.trim();
    const title = ($("pf-title") as HTMLInputElement).value.trim();
    if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) return flash("pf-msg", "bad slug", true);
    if (!title) return flash("pf-msg", "title required", true);
    const post = {
      slug,
      title,
      date: ($("pf-date") as HTMLInputElement).value,
      excerpt: ($("pf-excerpt") as HTMLInputElement).value.trim(),
      tags: ($("pf-tags") as HTMLInputElement).value.trim(),
      draft: ($("pf-draft") as HTMLInputElement).checked,
      body: ($("pf-body") as HTMLTextAreaElement).value,
    };
    const res = await apiPost({ action: "savePost", post });
    if (res?.error === "unauthorized") return handleUnauthorized("pf-msg");
    if (res?.posts) render(res);
    else await loadAndRender();
    $("post-form").hidden = true;
    flash("pf-msg", "saved");
  });

  $("posts-list").addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const editSlug = t.getAttribute("data-edit");
    const delSlug = t.getAttribute("data-del");
    if (editSlug) {
      const post = allPosts.find((p) => String(p.slug) === editSlug);
      if (post) openForm(post);
    }
    if (delSlug && confirm(`Delete "${delSlug}"?`)) {
      const res = await apiPost({ action: "deletePost", slug: delSlug });
      if (res?.error === "unauthorized") return handleUnauthorized("sf-msg");
      if (res?.posts) render(res);
      else await loadAndRender();
    }
  });

  // ---- workplaces ----
  function fyear(v: string) {
    if (!v) return "";
    const s = String(v);
    return /^\d{4}$/.test(s) ? s : s.split("-")[0];
  }
  function expRange(j: any) {
    return `${fyear(j.start)} – ${isTrue(j.current) ? "now" : fyear(j.end)}`;
  }
  function trimMonth(v: string) {
    const s = String(v || "");
    const m = s.match(/^\d{4}-\d{2}/);
    return m ? m[0] : s;
  }
  function renderExp(list: any[]) {
    const box = $("exp-list-admin");
    if (!list.length) {
      box.innerHTML = '<div class="text-ink-faint py-3">no workplaces yet — add one.</div>';
      return;
    }
    box.innerHTML = list
      .slice()
      .sort((a, b) => (String(a.start) < String(b.start) ? 1 : -1))
      .map(
        (j) =>
          '<div class="flex items-baseline gap-4 py-3 border-b border-rule">' +
          '<span class="font-mono text-[11px] text-ink-faint tabular w-24 shrink-0">' + esc(expRange(j)) + "</span>" +
          '<span class="flex-1 text-ink">' + esc(j.role) + ' <span class="text-ink-faint">· ' + esc(j.company) + "</span></span>" +
          '<button class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-faint hover:text-ink transition-colors" data-xedit="' + j._row + '">edit</button>' +
          '<button class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-faint hover:text-accent transition-colors" data-xdel="' + j._row + '">delete</button>' +
          "</div>",
      )
      .join("");
  }
  function openExpForm(entry: any | null) {
    editingRow = entry ? entry._row : null;
    ($("xf-role") as HTMLInputElement).value = entry ? entry.role ?? "" : "";
    ($("xf-company") as HTMLInputElement).value = entry ? entry.company ?? "" : "";
    ($("xf-location") as HTMLInputElement).value = entry ? entry.location ?? "" : "";
    ($("xf-start") as HTMLInputElement).value = entry ? trimMonth(entry.start) : "";
    ($("xf-end") as HTMLInputElement).value = entry ? trimMonth(entry.end) : "";
    ($("xf-current") as HTMLInputElement).checked = entry ? isTrue(entry.current) : false;
    ($("xf-description") as HTMLTextAreaElement).value = entry ? entry.description ?? "" : "";
    $("exp-form").hidden = false;
    $("xf-role").scrollIntoView({ behavior: "smooth", block: "center" });
  }

  $("x-new").addEventListener("click", () => openExpForm(null));
  $("xf-cancel").addEventListener("click", () => ($("exp-form").hidden = true));
  $("xf-save").addEventListener("click", async () => {
    const role = ($("xf-role") as HTMLInputElement).value.trim();
    const company = ($("xf-company") as HTMLInputElement).value.trim();
    if (!role || !company) return flash("xf-msg", "role + company required", true);
    const exp: any = {
      role,
      company,
      location: ($("xf-location") as HTMLInputElement).value.trim(),
      start: ($("xf-start") as HTMLInputElement).value.trim(),
      end: ($("xf-end") as HTMLInputElement).value.trim(),
      current: ($("xf-current") as HTMLInputElement).checked,
      description: ($("xf-description") as HTMLTextAreaElement).value.trim(),
    };
    if (editingRow) exp._row = editingRow;
    const res = await apiPost({ action: "saveExperience", experience: exp });
    if (res?.error === "unauthorized") return handleUnauthorized("xf-msg");
    if (res?.experience) render(res);
    else await loadAndRender();
    $("exp-form").hidden = true;
    flash("xf-msg", "saved");
  });
  $("exp-list-admin").addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const editRow = t.getAttribute("data-xedit");
    const delRow = t.getAttribute("data-xdel");
    if (editRow) {
      const entry = allExp.find((j) => String(j._row) === editRow);
      if (entry) openExpForm(entry);
    }
    if (delRow && confirm("Delete this workplace?")) {
      const res = await apiPost({ action: "deleteExperience", row: Number(delRow) });
      if (res?.error === "unauthorized") return handleUnauthorized("xf-msg");
      if (res?.experience) render(res);
      else await loadAndRender();
    }
  });

  // ---- projects ----
  function renderProjects(list: any[]) {
    const box = $("proj-list");
    if (!list.length) {
      box.innerHTML = '<div class="text-ink-faint py-3">no projects in the sheet — the static list on the site shows until you add one here.</div>';
      return;
    }
    box.innerHTML = list
      .map(
        (p) =>
          '<div class="flex items-baseline gap-4 py-3 border-b border-rule">' +
          '<span class="flex-1 text-ink">' + esc(p.title) +
          (isTrue(p.featured) ? ' <span class="text-ink-faint">★</span>' : "") + "</span>" +
          '<span class="font-mono text-[11px] text-ink-faint">' + esc(p.status || "") + "</span>" +
          '<button class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-faint hover:text-ink transition-colors" data-redit="' + esc(p.slug) + '">edit</button>' +
          '<button class="font-mono text-[11px] uppercase tracking-[0.1em] text-ink-faint hover:text-accent transition-colors" data-rdel="' + esc(p.slug) + '">delete</button>' +
          "</div>",
      )
      .join("");
  }
  function openProjForm(p: any | null) {
    editingProjSlug = p ? String(p.slug) : null;
    ($("rf-title") as HTMLInputElement).value = p ? p.title ?? "" : "";
    ($("rf-slug") as HTMLInputElement).value = p ? String(p.slug) : "";
    ($("rf-url") as HTMLInputElement).value = p ? p.url ?? "" : "";
    ($("rf-tagline") as HTMLInputElement).value = p ? p.tagline ?? "" : "";
    ($("rf-role") as HTMLInputElement).value = p ? p.role ?? "" : "full-stack";
    ($("rf-status") as HTMLInputElement).value = p ? p.status ?? "" : "live";
    ($("rf-accent") as HTMLInputElement).value = p ? p.accent ?? "" : "";
    ($("rf-stack") as HTMLInputElement).value = p ? String(p.stack ?? "") : "";
    ($("rf-image") as HTMLInputElement).value = p ? p.image ?? "" : "";
    ($("rf-description") as HTMLTextAreaElement).value = p ? p.description ?? "" : "";
    ($("rf-longDescription") as HTMLTextAreaElement).value = p ? p.longDescription ?? "" : "";
    ($("rf-featured") as HTMLInputElement).checked = p ? isTrue(p.featured) : false;
    $("proj-form").hidden = false;
    $("rf-title").scrollIntoView({ behavior: "smooth", block: "center" });
  }
  $("rf-title").addEventListener("input", () => {
    if (editingProjSlug) return;
    ($("rf-slug") as HTMLInputElement).value = slugify(($("rf-title") as HTMLInputElement).value);
  });
  $("pr-new").addEventListener("click", () => openProjForm(null));
  $("rf-cancel").addEventListener("click", () => ($("proj-form").hidden = true));
  $("rf-save").addEventListener("click", async () => {
    const slug = ($("rf-slug") as HTMLInputElement).value.trim();
    const title = ($("rf-title") as HTMLInputElement).value.trim();
    if (!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) return flash("rf-msg", "bad slug", true);
    if (!title) return flash("rf-msg", "title required", true);
    const project = {
      slug,
      title,
      tagline: ($("rf-tagline") as HTMLInputElement).value.trim(),
      role: ($("rf-role") as HTMLInputElement).value.trim(),
      status: ($("rf-status") as HTMLInputElement).value.trim(),
      stack: ($("rf-stack") as HTMLInputElement).value.trim(),
      url: ($("rf-url") as HTMLInputElement).value.trim(),
      image: ($("rf-image") as HTMLInputElement).value.trim(),
      description: ($("rf-description") as HTMLTextAreaElement).value.trim(),
      longDescription: ($("rf-longDescription") as HTMLTextAreaElement).value.trim(),
      accent: ($("rf-accent") as HTMLInputElement).value.trim(),
      featured: ($("rf-featured") as HTMLInputElement).checked,
    };
    const res = await apiPost({ action: "saveProject", project });
    if (res?.error === "unauthorized") return handleUnauthorized("rf-msg");
    if (res?.projects) render(res);
    else await loadAndRender();
    $("proj-form").hidden = true;
    flash("rf-msg", "saved");
  });
  $("proj-list").addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const editSlug = t.getAttribute("data-redit");
    const delSlug = t.getAttribute("data-rdel");
    if (editSlug) {
      const p = allProjects.find((x) => String(x.slug) === editSlug);
      if (p) openProjForm(p);
    }
    if (delSlug && confirm(`Delete "${delSlug}"?`)) {
      const res = await apiPost({ action: "deleteProject", slug: delSlug });
      if (res?.error === "unauthorized") return handleUnauthorized("rf-msg");
      if (res?.projects) render(res);
      else await loadAndRender();
    }
  });

  function handleUnauthorized(msgId: string) {
    sessionStorage.removeItem("adminToken");
    flash(msgId, "wrong password", true);
    showGate();
  }

  // ---- gate ----
  async function tryUnlock() {
    const pw = ($("pw") as HTMLInputElement).value;
    if (!pw) return;
    sessionStorage.setItem("adminToken", pw);
    $("gate-msg").textContent = "checking…";
    const res = await apiPost({ action: "ping" });
    if (res?.ok) {
      $("gate-msg").textContent = "";
      showEditor();
      await loadAndRender();
    } else if (res?.error === "unauthorized") {
      sessionStorage.removeItem("adminToken");
      $("gate-msg").textContent = "wrong password";
    } else {
      // couldn't read the response — proceed optimistically
      $("gate-msg").textContent = "";
      showEditor();
      await loadAndRender();
    }
  }

  $("unlock-btn").addEventListener("click", tryUnlock);
  $("pw").addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Enter") tryUnlock();
  });
  lockBtn.addEventListener("click", () => {
    sessionStorage.removeItem("adminToken");
    showGate();
  });

  // ---- boot ----
  (async () => {
    const state = await fetchState();
    if (!API || !state) {
      statusEl.textContent = "not connected";
      showGate();
      gateEl.hidden = true; // nothing to unlock into yet
      return;
    }
    statusEl.textContent = "● connected";
    statusEl.className = "font-mono text-[11px] uppercase tracking-[0.12em] text-accent";
    if (sessionStorage.getItem("adminToken")) {
      showEditor();
      render(state);
    } else {
      showGate();
    }
  })();
</script>
