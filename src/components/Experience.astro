---
import profile from "../data/profile.json";

function fmt(v: string) {
  if (!v) return "";
  if (/^\d{4}$/.test(v)) return v;
  const [y, m] = v.split("-");
  const month = new Intl.DateTimeFormat("en-GB", { month: "short" }).format(new Date(Number(y), Number(m) - 1));
  return `${month} ${y}`;
}
const range = (s: string, e: string, current: boolean) => `${fmt(s)} – ${current ? "present" : fmt(e)}`;
---

<section id="experience" class="relative px-5 md:px-8 py-28 md:py-36 bg-bg-2 border-y border-rule">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12" data-reveal>
      <div class="eyebrow mb-3">§ 02 – experience</div>
      <h2 class="font-display text-[44px] md:text-[64px] leading-[1.02]">
        Where I&apos;ve <span class="mark">worked</span>.
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-12">
      {/* Work */}
      <div class="lg:col-span-8">
        <ol class="border-t border-rule">
          {profile.experience.map((job, i) => (
            <li class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-2 py-7 border-b border-rule" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <div class="md:col-span-4 font-mono text-[12px] text-ink-faint">
                <div class="tabular">{range(job.start, job.end, job.current)}</div>
                <div class="mt-1 text-ink-dim">{job.location}</div>
              </div>
              <div class="md:col-span-8">
                <h3 class="font-display text-[24px] md:text-[28px] leading-[1.15]">
                  {job.role}
                  <span class="text-ink-faint"> · {job.company}</span>
                </h3>
                <p class="mt-2 text-[15px] leading-[1.6] text-ink-soft max-w-prose">{job.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      {/* Education */}
      <aside class="lg:col-span-4" data-reveal style="--reveal-delay:120ms">
        <div class="eyebrow mb-5">education</div>
        <ul class="space-y-6">
          {profile.education.map((ed) => (
            <li class="border-l-2 border-rule-hi pl-4">
              <div class="font-display text-[20px] leading-[1.2]">{ed.degree}</div>
              <div class="mt-1 text-[14px] text-ink-soft">{ed.school}</div>
              <div class="mt-1 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint tabular">
                {range(ed.start, ed.end, ed.current)}
              </div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>
