---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

function fmt(d: Date) {
  return new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" }).format(d);
}
---

<section id="writing" class="relative px-5 md:px-8 py-28 md:py-36">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-end justify-between mb-12" data-reveal>
      <div>
        <div class="eyebrow mb-3">§ 06 – writing</div>
        <h2 class="font-display text-[44px] md:text-[64px] leading-[1] tracking-tight">
          Notes from the field<span class="text-accent">.</span>
        </h2>
      </div>
      <a href="/blog" class="hidden md:inline-flex link-arrow font-mono text-[12px] uppercase tracking-[0.14em] text-ink-soft hover:text-accent transition-colors">
        <span>all posts</span><span class="arrow">→</span>
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="text-ink-soft max-w-[58ch]" data-reveal>
        Nothing published yet – I'm writing the first few. Check back soon.
      </p>
    ) : (
      <ul class="divide-y divide-rule border-y border-rule">
        {posts.map((p, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <a href={`/blog/${p.id}`} class="group grid grid-cols-12 gap-x-6 gap-y-2 py-6 items-baseline">
              <div class="col-span-3 md:col-span-2 font-mono text-[12px] text-ink-faint tabular">
                {fmt(p.data.date)}
              </div>
              <div class="col-span-9 md:col-span-7">
                <h3 class="font-display text-[26px] md:text-[32px] leading-[1.1] text-ink group-hover:text-accent transition-colors">
                  {p.data.title}
                </h3>
                <p class="mt-1 text-[14.5px] text-ink-soft max-w-[60ch]">{p.data.excerpt}</p>
              </div>
              <div class="col-span-12 md:col-span-3 md:text-right font-mono text-[11px] uppercase tracking-[0.14em] text-ink-faint">
                {p.data.tags.slice(0, 2).join(" · ")}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-10 md:hidden" data-reveal>
      <a href="/blog" class="btn">all posts →</a>
    </div>
  </div>
</section>
