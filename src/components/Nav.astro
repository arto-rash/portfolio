---
import profile from "../data/profile.json";

interface Props {
  showHome?: boolean;
}
const { showHome = false } = Astro.props;
---

<header
  class="fixed inset-x-0 top-0 z-40 backdrop-blur-md bg-bg/80 border-b border-rule"
>
  <div class="mx-auto max-w-4xl px-5 md:px-8 h-14 flex items-center justify-between">
    <a href="/" class="font-mono text-[11px] tracking-[0.16em] uppercase text-ink">
      {profile.shortName}.{profile.lastName}
    </a>

    <nav class="hidden sm:flex items-center gap-7 font-mono text-[11px] tracking-[0.12em] uppercase text-ink-faint">
      <a href={showHome ? "/#work" : "#work"} class="hover:text-ink transition-colors">work</a>
      <a href="/about" class="hover:text-ink transition-colors">about</a>
      <a href="/blog" class="hover:text-ink transition-colors">writing</a>
      <a href={showHome ? "/#contact" : "#contact"} class="hover:text-ink transition-colors">contact</a>
    </nav>

    <nav class="sm:hidden flex items-center gap-5 font-mono text-[11px] tracking-[0.12em] uppercase text-ink-faint">
      <a href="/about" class="hover:text-ink transition-colors">about</a>
      <a href="/blog" class="hover:text-ink transition-colors">writing</a>
    </nav>
  </div>
</header>
