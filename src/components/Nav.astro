---
interface Props {
  showHome?: boolean;
}
const { showHome = false } = Astro.props;
const links = [
  { label: "work", href: showHome ? "/#work" : "#work" },
  { label: "notes", href: "/blog" },
  { label: "about", href: "/about" },
  { label: "contact", href: showHome ? "/#contact" : "#contact" },
];
---

<header class="fixed inset-x-0 top-0 z-40 bg-bg/90 backdrop-blur-sm border-b-2 border-ink">
  <div class="mx-auto max-w-5xl px-5 md:px-8 h-14 flex items-center justify-between gap-4 font-mono text-[11px] uppercase tracking-[0.12em]">
    <a href="/" class="text-ink whitespace-nowrap">
      logbook <span class="text-ink-faint">· a. rashid</span>
    </a>
    <nav class="flex items-center gap-4 sm:gap-6 text-ink-faint">
      {links.map((l, i) => (
        <a href={l.href} class:list={["hover:text-accent transition-colors", i === 3 && "hidden sm:inline"]}>{l.label}</a>
      ))}
    </nav>
    <span class="hidden md:inline text-ink-faint tabular">40.4°N 49.9°E</span>
  </div>
</header>
