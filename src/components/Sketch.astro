---
// Hand-drawn system sketch for a logbook entry, keyed by slug.
// Only flagships (and the rover) have one; anything else renders nothing.
interface Props {
  slug: string;
  draw?: boolean;
}
const { slug, draw = false } = Astro.props;
const cls = draw ? "sketch draw" : "sketch";
---

{slug === "escaflow" && (
  <svg class={cls} viewBox="0 0 300 112" role="img" aria-label="Camera feeds go to a YOLO and OpenCV model, which sends alerts to a dispatcher">
    <text class="m" x="120" y="16">falls, crowding</text>
    <rect x="8" y="34" width="70" height="40" />
    <text x="16" y="58">camera ×n</text>
    <path d="M78 54 H112" /><path d="M106 49 L112 54 L106 59" />
    <rect x="114" y="28" width="76" height="52" />
    <text x="124" y="50">YOLO +</text>
    <text x="124" y="64">OpenCV</text>
    <path d="M190 54 H222" /><path d="M216 49 L222 54 L216 59" />
    <rect x="224" y="34" width="68" height="40" />
    <text x="232" y="58">dispatch</text>
    <path class="m" d="M130 22 C 140 24, 150 26, 152 28" />
    <path d="M258 74 V96 H40 V74" stroke-dasharray="3 4" />
    <text x="96" y="108">human confirms every alert</text>
  </svg>
)}

{slug === "fermachi" && (
  <svg class={cls} viewBox="0 0 300 112" role="img" aria-label="Farmers and machinery owners meet on a marketplace, advised by FermachiAI">
    <circle cx="40" cy="30" r="16" />
    <text x="22" y="62">farmer</text>
    <circle cx="40" cy="90" r="12" />
    <text x="60" y="96">owner</text>
    <path d="M58 32 L130 52 M54 86 L130 62" />
    <rect x="132" y="36" width="84" height="40" />
    <text x="140" y="54">marketplace</text>
    <text x="140" y="68">+ auctions</text>
    <path d="M216 56 H244" />
    <circle class="m" cx="268" cy="56" r="20" />
    <text class="m" x="268" y="56" text-anchor="middle" dominant-baseline="central">AI</text>
    <text class="m" x="200" y="20">agronomist!</text>
  </svg>
)}

{slug === "jabish" && (
  <svg class={cls} viewBox="0 0 300 112" role="img" aria-label="Teachers generate exams with AI; students search for tutors">
    <rect x="8" y="14" width="70" height="30" />
    <text x="18" y="33">teacher</text>
    <path d="M78 29 H112" /><path d="M106 24 L112 29 L106 34" />
    <circle class="m" cx="134" cy="29" r="18" />
    <text class="m" x="134" y="29" text-anchor="middle" dominant-baseline="central">AI</text>
    <path d="M152 29 H186" /><path d="M180 24 L186 29 L180 34" />
    <path d="M190 12 h70 v34 h-70 z M200 22 h40 M200 30 h50 M200 38 h30" />
    <rect x="8" y="70" width="70" height="30" />
    <text x="18" y="89">student</text>
    <path d="M78 85 H186" stroke-dasharray="3 4" /><path d="M180 80 L186 85 L180 90" />
    <circle cx="206" cy="80" r="8" /><path d="M192 102 C 196 90, 216 90, 220 102" />
    <text x="230" y="90">tutor</text>
  </svg>
)}

{slug === "rover" && (
  <svg class={cls} viewBox="0 0 300 112" role="img" aria-label="Side view of a two-person, pedal-powered rover crossing rough ground toward a crater">
    <text class="m" x="122" y="12">first team from AZ</text>
    <path class="m" d="M119 8 C 112 4, 104 5, 97 10" />
    <path class="m" d="M101 6 L97 10 L102 12" />
    <text x="8" y="50">2 pilots,</text>
    <text x="8" y="62">pedal power</text>

    {/* flag on a mast, waving back */}
    <path d="M93 70 L88 10" />
    <path class="m" d="M88 10 C 80 9, 74 15, 66 13 L 70 20 C 77 22, 82 17, 88.6 18" />

    {/* ground, a rock behind, a crater ahead */}
    <path d="M6 102 H238 C 244 102, 246 109, 254 109 C 262 109, 264 102, 270 102 H294" />
    <path d="M34 102 l4 -5 l6 1 l3 4" />
    <path d="M276 102 l3 -4 l5 0 l2 4" />
    <text x="252" y="94">crater</text>
    <path d="M28 76 h16 M22 84 h20 M28 92 h16" stroke-dasharray="4 3" />

    {/* far-side wheels peeking out: it's a four-wheeler */}
    <circle cx="86" cy="82" r="18" stroke-dasharray="2 4" />
    <circle cx="222" cy="82" r="18" stroke-dasharray="2 4" />

    {/* wheels with spokes */}
    <circle cx="78" cy="84" r="18" />
    <circle cx="78" cy="84" r="3" />
    <path d="M78 66 V102 M60 84 H96 M65 71 L91 97 M91 71 L65 97" />
    <circle cx="214" cy="84" r="18" />
    <circle cx="214" cy="84" r="3" />
    <path d="M214 66 V102 M196 84 H232 M201 71 L227 97 M227 71 L201 97" />

    {/* chassis, seats, cranks, steering */}
    <path d="M78 84 L124 86 L170 86 L214 84 M78 84 L108 56 L124 86 M154 56 L170 86 M108 56 L200 54 L214 84" />
    <path d="M100 56 h14 M146 56 h14" />
    <circle cx="124" cy="86" r="5" />
    <circle cx="170" cy="86" r="5" />
    <path d="M200 54 L196 42 H188" />

    {/* pilots */}
    <circle cx="110" cy="26" r="6" />
    <path d="M110 32 L106 54 M109 38 L126 46 L134 51 M106 54 L126 68 L127 90" />
    <circle cx="156" cy="26" r="6" />
    <path d="M156 32 L152 54 M155 38 L176 42 L188 42 M152 54 L172 68 L173 90" />
  </svg>
)}
