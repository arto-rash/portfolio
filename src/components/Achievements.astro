---
import achievements from "../data/achievements.json";

const items = achievements.map((a) => {
  const hl = (a.highlight ?? "").trim();
  const idx = hl ? a.detail.toLowerCase().indexOf(hl.toLowerCase()) : -1;
  if (hl && idx >= 0) {
    return {
      ...a,
      before: a.detail.slice(0, idx),
      markText: a.detail.slice(idx, idx + hl.length),
      after: a.detail.slice(idx + hl.length),
    };
  }
  return { ...a, before: a.detail, markText: "", after: "" };
});
---

<section id="achievements" class="relative px-5 md:px-8 py-28 md:py-36 bg-bg-2 border-y border-rule">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-end justify-between mb-12" data-reveal>
      <div>
        <div class="eyebrow mb-3">§ 04 – milestones</div>
        <h2 class="font-display text-[44px] md:text-[64px] leading-[1.02]">
          Proof of <span class="mark">work</span>.
        </h2>
      </div>
      <div class="hidden md:block font-mono text-[11px] uppercase tracking-[0.16em] text-ink-faint">
        rovers · robots · stages
      </div>
    </div>

    <p class="text-ink-soft max-w-[58ch] mb-10" data-reveal>
      A mix of robotics and STEM competitions, hackathons, olympiads, and a couple of things that
      have nothing to do with a keyboard.
    </p>

    <ol class="border-t border-rule">
      {items.map((a, i) => (
        <li
          class="grid grid-cols-12 gap-x-4 gap-y-1 py-6 border-b border-rule"
          data-reveal
          style={`--reveal-delay:${(i % 6) * 50}ms`}
        >
          <div class="col-span-12 md:col-span-2 font-mono text-[12px] text-ink-faint tabular">
            {a.when}
          </div>
          <div class="col-span-12 md:col-span-8">
            <h3 class="font-display text-[22px] md:text-[26px] leading-[1.15]">{a.title}</h3>
            <p class="mt-1.5 text-[15px] leading-[1.6] text-ink-soft max-w-prose">
              {a.before}{a.markText && <span class="mark">{a.markText}</span>}{a.after}
            </p>
          </div>
          <div class="col-span-12 md:col-span-2 md:text-right font-mono text-[11px] uppercase tracking-[0.12em] text-ink-faint">
            {a.category}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
