---
interface Props {
  index: number;
  total: number;
  slug: string;
  title: string;
  tagline: string;
  year: number;
  role: string;
  status: string;
  description: string;
  stack: string[];
  url?: string;
  source?: string;
  accent?: string;
  resolvedImage: string | null;
}

const {
  index,
  total,
  slug,
  title,
  tagline,
  year,
  role,
  status,
  description,
  stack,
  url,
  source,
  accent = "#d97757",
  resolvedImage,
} = Astro.props;

const num = String(index + 1).padStart(2, "0");
const of = String(total).padStart(2, "0");
const statusClass = status === "live" ? "text-accent" : status === "shelved" ? "italic text-ink-faint" : "text-warn";
const primaryLink = url || source || "#";
const hasLink = Boolean(url || source);
---

<article class="project-card" data-reveal style={`--accent:${accent}`}>
  {/* Hover preview */}
  <div
    class={`preview ${resolvedImage ? "" : "preview-fallback"}`}
    style={resolvedImage ? `background-image:url('${resolvedImage}')` : undefined}
    aria-hidden="true"
  >
    {!resolvedImage && (
      <div class="absolute inset-0 flex items-center justify-center font-display text-[80px] text-ink/30">
        {title.slice(0, 2).toLowerCase()}
      </div>
    )}
  </div>

  <div class="relative z-10 grid grid-cols-12 gap-x-6 gap-y-4">
    {/* Left meta */}
    <div class="col-span-12 md:col-span-2 flex md:flex-col gap-3 md:gap-1 font-mono text-[12px] text-ink-faint">
      <span class="tabular text-ink-soft">{num} / {of}</span>
      <span aria-hidden="true" class="md:hidden">·</span>
      <span class={statusClass}>{status}</span>
      <span class="tabular">{year}</span>
    </div>

    {/* Main */}
    <div class="col-span-12 md:col-span-7">
      <h3 class="project-title font-display text-[34px] md:text-[44px] leading-[1.04] tracking-tight">
        {hasLink ? (
          <a href={primaryLink} target="_blank" rel="noreferrer" class="link-arrow">
            <span>{title}</span>
            <span class="arrow text-ink-faint text-[0.5em] align-middle">↗</span>
          </a>
        ) : (
          <span>{title}</span>
        )}
      </h3>
      <p class="mt-2 text-[15px] md:text-[16px] text-ink italic font-display">{tagline}</p>
      <p class="mt-4 text-[15px] leading-[1.65] text-ink-soft max-w-prose">{description}</p>
    </div>

    {/* Right column — stack + links */}
    <aside class="col-span-12 md:col-span-3 font-mono text-[12px] text-ink-faint md:text-right space-y-3">
      <div class="space-y-1">
        <div class="eyebrow md:text-right">stack</div>
        <div class="flex md:justify-end flex-wrap gap-x-2 gap-y-1 text-ink-soft">
          {stack.map((s, i) => (
            <span>{s}{i < stack.length - 1 && <span class="text-ink-dim"> · </span>}</span>
          ))}
        </div>
      </div>

      <div class="space-y-1 md:text-right">
        <div class="eyebrow md:text-right">role</div>
        <div class="text-ink-soft">{role}</div>
      </div>

      <div class="flex md:justify-end gap-3 pt-1">
        {url && (
          <a href={url} target="_blank" rel="noreferrer" class="link-arrow text-ink hover:text-accent transition-colors">
            <span>live</span><span class="arrow">↗</span>
          </a>
        )}
        {source && (
          <a href={source} target="_blank" rel="noreferrer" class="link-arrow text-ink hover:text-accent transition-colors">
            <span>source</span><span class="arrow">↗</span>
          </a>
        )}
      </div>
    </aside>
  </div>
</article>
