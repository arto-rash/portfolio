---
import profile from "../data/profile.json";

const socials = [
  { label: "email", href: `mailto:${profile.social.email}`, value: profile.social.email },
  { label: "github", href: profile.social.github, value: "@artoghrulrashid" },
  { label: "linkedin", href: profile.social.linkedin, value: "/in/artoghrulrashid" },
  { label: "twitter", href: profile.social.twitter, value: "@artoghrulrashid" },
].filter((s) => s.href && !s.href.endsWith("/"));
---

<section id="contact" class="relative px-5 md:px-8 py-28 md:py-40 overflow-hidden">
  {/* big background word */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 flex justify-center">
    <span class="font-display text-[clamp(180px,28vw,420px)] leading-none text-ink-dim/50 select-none translate-y-[28%]">
      hello
    </span>
  </div>

  <div class="mx-auto max-w-6xl">
    <div class="eyebrow mb-4" data-reveal>§ 04 — contact</div>
    <h2 class="font-display text-[56px] md:text-[96px] leading-[0.95] tracking-tight max-w-[12ch]" data-reveal style="--reveal-delay:80ms">
      Have something <span class="italic text-accent">interesting</span> to build?
    </h2>

    <p class="mt-8 text-[17px] md:text-[19px] text-ink-soft max-w-[55ch]" data-reveal style="--reveal-delay:180ms">
      I read everything, reply to most of it. The fastest way in is a real email — tell me
      what you're working on, what's stuck, and what good looks like.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:280ms">
      <a href={`mailto:${profile.social.email}`} class="btn btn-primary magnetic" data-strength="0.18">
        <span class="magnetic-inner">{profile.social.email} →</span>
      </a>
      <a href={profile.social.github} target="_blank" rel="noreferrer" class="btn magnetic" data-strength="0.18">
        <span class="magnetic-inner">github ↗</span>
      </a>
    </div>

    <ul class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-6 font-mono text-[13px] border-t border-rule pt-8" data-reveal style="--reveal-delay:380ms">
      {socials.map((s) => (
        <li>
          <div class="eyebrow mb-1">{s.label}</div>
          <a href={s.href} target={s.href.startsWith("mailto:") ? undefined : "_blank"} rel="noreferrer" class="text-ink hover:text-accent transition-colors break-all">
            {s.value}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
