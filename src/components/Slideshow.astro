---
interface Props {
  images?: string[];
  alt?: string;
  ratio?: string; // tailwind aspect class, e.g. "aspect-[16/10]"
  class?: string;
}
const { images = [], alt = "", ratio = "aspect-[16/10]", class: klass = "" } = Astro.props;
const multiple = images.length > 1;
---

{images.length > 0 && (
  <div class={`slideshow group relative ${klass}`} data-slideshow>
    <div class={`relative ${ratio} w-full overflow-hidden bg-bg-2`}>
      {images.map((src, i) => (
        <img
          src={src}
          alt={alt}
          loading={i === 0 ? "eager" : "lazy"}
          data-slide={i}
          class="absolute inset-0 w-full h-full object-cover object-top transition-opacity duration-300"
          style={`opacity:${i === 0 ? 1 : 0}`}
        />
      ))}

      {multiple && (
        <>
          <button
            type="button"
            data-prev
            aria-label="Previous image"
            class="absolute left-3 top-1/2 -translate-y-1/2 grid place-items-center w-9 h-9 bg-bg/85 backdrop-blur-sm border border-rule text-ink-faint hover:text-ink hover:border-ink transition-colors"
          >‹</button>
          <button
            type="button"
            data-next
            aria-label="Next image"
            class="absolute right-3 top-1/2 -translate-y-1/2 grid place-items-center w-9 h-9 bg-bg/85 backdrop-blur-sm border border-rule text-ink-faint hover:text-ink hover:border-ink transition-colors"
          >›</button>
          <div class="absolute top-3 right-3 font-mono text-[10px] uppercase tracking-[0.16em] text-ink bg-bg/85 backdrop-blur-sm px-2 py-1 border border-rule tabular">
            <span data-current>1</span>/{images.length}
          </div>
        </>
      )}
    </div>

    {multiple && (
      <div class="mt-3 flex items-center justify-center gap-2" data-dots>
        {images.map((_, i) => (
          <button
            type="button"
            data-dot={i}
            aria-label={`Go to image ${i + 1}`}
            class="h-1 transition-all duration-200"
            style={i === 0 ? "width:22px;background:var(--color-ink)" : "width:8px;background:var(--color-rule-hi)"}
          ></button>
        ))}
      </div>
    )}
  </div>
)}

<script>
  const init = () => {
    document.querySelectorAll<HTMLElement>("[data-slideshow]").forEach((root) => {
      if (root.dataset.ssBound) return;
      root.dataset.ssBound = "1";

      const slides = Array.from(root.querySelectorAll<HTMLImageElement>("[data-slide]"));
      if (slides.length < 2) return;
      const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
      const current = root.querySelector<HTMLElement>("[data-current]");
      let i = 0;

      const show = (n: number) => {
        i = (n + slides.length) % slides.length;
        slides.forEach((s, j) => (s.style.opacity = j === i ? "1" : "0"));
        dots.forEach((d, j) => {
          d.style.width = j === i ? "22px" : "8px";
          d.style.background = j === i ? "var(--color-ink)" : "var(--color-rule-hi)";
        });
        if (current) current.textContent = String(i + 1);
      };

      root.querySelector("[data-prev]")?.addEventListener("click", () => show(i - 1));
      root.querySelector("[data-next]")?.addEventListener("click", () => show(i + 1));
      dots.forEach((d, j) => d.addEventListener("click", () => show(j)));

      root.tabIndex = 0;
      root.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(i - 1);
        if (e.key === "ArrowRight") show(i + 1);
      });
    });
  };
  init();
  document.addEventListener("astro:page-load", init);
</script>
