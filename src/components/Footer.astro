---
const year = new Date().getFullYear();
---

<footer class="border-t border-rule px-5 md:px-8 py-8">
  <div class="mx-auto max-w-6xl flex flex-wrap items-center justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-faint">
    <span>© {year} — artoghrul rashid</span>
    <span>built with astro · tailwind · lenis · attention</span>
    <span class="flex items-center gap-2">
      <span class="dot"></span>
      <span class="tabular text-ink-soft" data-clock>--:--</span>
      <span>baku</span>
    </span>
  </div>
</footer>
